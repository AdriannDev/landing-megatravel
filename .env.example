NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://megatravel:megatravel@localhost:5432/megatravel
# Local development only. Remove DATABASE_URL and set USE_SQLITE=true to use SQLite.
USE_SQLITE=false
SQLITE_URL=file:./megatravel.db
# Empty DB / first account: bootstrap privately through CLI, never in public production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional absolute directory for local uploads. In Docker: /app/media.
# Without R2, mount a persistent volume here before uploading production files.
MEDIA_DIR=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
IMPORT_MEDIA_ALLOWED_HOSTS=i.imgur.com,i.spread.name
CRON_SECRET=
NEXT_PUBLIC_GA4_ID=
# Opt in to the prepared, public workbook snapshot before CMS migration.
CATALOG_SOURCE=workbook
