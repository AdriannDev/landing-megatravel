{
  "name": "megatravel-bloqueos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.22.1" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "payload generate:importmap && next build --webpack",
    "start": "node scripts/start.mjs",
    "bootstrap": "tsx --env-file-if-exists=.env.local scripts/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "tsx --env-file-if-exists=.env.local scripts/verify-cms.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "node --env-file-if-exists=.env.local node_modules/payload/bin.js migrate:create",
    "migrate": "node --env-file-if-exists=.env.local node_modules/payload/bin.js migrate",
    "import:workbook": "node scripts/prepare-workbook.mjs",
    "import:cms": "tsx --env-file-if-exists=.env.local scripts/import-cms.ts",
    "retire": "tsx scripts/retire.ts",
    "check:source": "node scripts/check-source.mjs",
    "check:domain": "node scripts/check-domain-types.mjs",
    "backup": "node --env-file=.env.local scripts/backup.mjs",
    "restore:test": "node --env-file=.env.local scripts/backup.mjs --restore",
    "check:repository": "node scripts/check-repository.mjs",
    "prepare:commits": "node scripts/prepare-commits.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.13",
    "typescript": "6.0.3"
  }
}
